<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Danh sách bài viết</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/">Trang chủ</a>
    <a href="/news">Tin tức</a>
    <a href="/news/add">Thêm bài viết</a>
  </nav>

  <h1>Danh sách bài viết</h1>

  <ul>
    <% posts.forEach(post => { %>
      <li>
        <h3>
          <a href="/news/<%= post.id %>"><%= post.title %></a>
        </h3>
        <p><%= post.description %></p>

        <a href="/news/<%= post.id %>/edit">Sửa</a>
      </li>
    <% }) %>
  </ul>
</body>
</html>
