<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Danh sách bài viết</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/">Trang chủ</a>
    <a href="/news">Tin tức</a>
    <% if (user) { %>
      <span>Xin chào, <%= user.username %></span>
      <a href="/logout">Đăng xuất</a>
    <% } else { %>
      <a href="/login">Đăng nhập</a>
    <% } %>
  </nav>

  <main class="container">
    <h1>Danh sách bài viết</h1>

    <form class="search-form" method="GET" action="/news/search">
      <input type="text" name="keyword" value="<%= keyword || '' %>" placeholder="Nhập từ khóa">
      <button type="submit">Tìm kiếm</button>
    </form>

    <% if (user) { %>
      <p><a class="button" href="/news/add">Thêm bài viết</a></p>
    <% } %>

    <% if (posts.length === 0) { %>
      <div class="card">Không có bài viết nào.</div>
    <% } %>

    <ul>
      <% posts.forEach(post => { %>
        <li>
          <h3>
            <a href="/news/<%= post.id %>"><%= post.title %></a>
          </h3>
          <p class="muted"><%= post.description %></p>

          <% if (user) { %>
            <div class="actions">
              <a class="button" href="/news/<%= post.id %>/edit">Sửa</a>
              <form action="/news/<%= post.id %>/delete" method="POST">
                <button type="submit" onclick="return confirm('Bạn có chắc muốn xóa bài viết này?')">Xóa</button>
              </form>
            </div>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </main>
</body>
</html>
